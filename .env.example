POSTGRES_DB="cleanhub"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

DATABASE_URL="postgres://postgres:postgres@localhost:5432/cleanhub"
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"
DATABASE_POOL_QUERY_TIMEOUT_MS="30000"
DATABASE_POOL_KEEP_ALIVE_INITIAL_DELAY_MS="10000"
DATABASE_APPLICATION_NAME="cleanhub"
AUTH_TOKEN_SECRET="change-me-to-a-random-secret-with-at-least-32-characters"
AUTH_ACCESS_TOKEN_TTL_SECONDS="900"
AUTH_REFRESH_TOKEN_TTL_SECONDS="2592000"
AUTH_COOKIE_SECURE="false"
LOG_LEVEL="info"
SERVICE_NAME="cleanhub"
NEXT_PUBLIC_APP_ENV="local"
# API base URL used by web-admin and pos-web (server prefers CLEANHUB_API_BASE_URL,
# browsers read NEXT_PUBLIC_API_BASE_URL).
CLEANHUB_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
# Comma-separated list of allowed browser origins for the API.
# Must include every frontend dev port: web-admin (:3000), pos-web (:3001), and mobile-web (:3002).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
# POS terminal binding. A POS device is single-store, so the tenant code
# (pressing_code) is fixed per terminal instead of entered per login.
# Mirrored to NEXT_PUBLIC_ so the browser-side login form can read it.
POS_TENANT_CODE="CLEAN-001"
NEXT_PUBLIC_POS_TENANT_CODE="CLEAN-001"
