POSTGRES_DB="cleanhub"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

MINIO_ROOT_USER="cleanhub"
MINIO_ROOT_PASSWORD="cleanhub-minio-password"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"

DATABASE_URL="postgres://postgres:postgres@localhost:5432/cleanhub"
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"
DATABASE_POOL_QUERY_TIMEOUT_MS="30000"
DATABASE_POOL_KEEP_ALIVE_INITIAL_DELAY_MS="10000"
DATABASE_APPLICATION_NAME="cleanhub"
AUTH_TOKEN_SECRET="change-me-to-a-random-secret-with-at-least-32-characters"
AUTH_ACCESS_TOKEN_TTL_SECONDS="28800"
AUTH_REFRESH_TOKEN_TTL_SECONDS="2592000"
AUTH_COOKIE_SECURE="false"
LOG_LEVEL="info"
SERVICE_NAME="cleanhub"
NEXT_PUBLIC_APP_ENV="local"
# API base URL used by web-admin and pos-web (server prefers CLEANHUB_API_BASE_URL,
# browsers read NEXT_PUBLIC_API_BASE_URL).
CLEANHUB_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
# Comma-separated list of allowed browser origins for the API.
# Must include every frontend dev port: web-admin (:3000), pos-web (:3001), and mobile-web (:3002).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
# POS terminal binding. A POS device is single-store, so the tenant code
# (pressing_code) is fixed per terminal instead of entered per login.
# Mirrored to NEXT_PUBLIC_ so the browser-side login form can read it.
POS_TENANT_CODE="CLEAN-001"
NEXT_PUBLIC_POS_TENANT_CODE="CLEAN-001"

# Object storage for media proof photos/signatures. Local development uses the
# MinIO service from docker-compose.yml; production should use dedicated strong
# credentials and a private bucket.
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="cleanhub-media"
OBJECT_STORAGE_ACCESS_KEY="cleanhub"
OBJECT_STORAGE_SECRET_KEY="cleanhub-minio-password"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS="900"
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS="300"
OBJECT_STORAGE_PENDING_TTL_SECONDS="3600"
OBJECT_STORAGE_MAX_FILE_SIZE_BYTES="5242880"
OBJECT_STORAGE_ALLOWED_CONTENT_TYPES="image/jpeg,image/png,image/webp"

# Email notifications. Local development can point this at Mailpit or MailHog
# on port 1025; production should use authenticated SMTP and a verified sender.
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT="1025"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM="CleanHub <no-reply@cleanhub.local>"
EMAIL_DEFAULT_LOCALE="en"
EMAIL_DELIVERY_DISABLED="false"
EMAIL_DELIVERY_INTERVAL_SECONDS="60"
EMAIL_DELIVERY_BATCH_SIZE="50"
EMAIL_DELIVERY_RETRY_BASE_SECONDS="60"
EMAIL_DELIVERY_RETRY_MAX_SECONDS="3600"
EMAIL_OVERDUE_TICKET_DISABLED="false"
EMAIL_OVERDUE_TICKET_BATCH_SIZE="100"
