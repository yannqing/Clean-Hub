POSTGRES_DB="cleanhub"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

MINIO_ROOT_USER="cleanhub"
MINIO_ROOT_PASSWORD="cleanhub-minio-password"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"

DATABASE_URL="postgres://postgres:postgres@localhost:5432/cleanhub"
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"
DATABASE_POOL_QUERY_TIMEOUT_MS="30000"
DATABASE_POOL_KEEP_ALIVE_INITIAL_DELAY_MS="10000"
DATABASE_APPLICATION_NAME="cleanhub"
# Local Docker uses the PostgreSQL superuser, so RLS enforcement is checked but
# not required. Production must use a non-superuser, non-BYPASSRLS app role.
DATABASE_REQUIRE_RLS="false"
AUTH_TOKEN_SECRET="change-me-to-a-random-secret-with-at-least-32-characters"
AUTH_ACCESS_TOKEN_TTL_SECONDS="28800"
AUTH_REFRESH_TOKEN_TTL_SECONDS="2592000"
AUTH_COOKIE_SECURE="false"
# 32-byte key used to encrypt tenant payment provider credentials at rest.
# Generate one with: openssl rand -base64 32
# Production startup/payment configuration must provide a unique secret value.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=""
# HMAC secret for the mock payment gateway's webhook.
# The webhook route is intentionally unauthenticated (payment providers cannot
# present a session), so this secret is the ONLY thing preventing a forged
# callback from marking an order paid. Leave blank for local development; the
# API refuses to start in production without it.
# Generate one with: openssl rand -base64 32
PAYMENT_MOCK_SECRET=""
LOG_LEVEL="info"
SERVICE_NAME="cleanhub"
NEXT_PUBLIC_APP_ENV="local"
# API base URL used by web-admin and pos-web (server prefers CLEANHUB_API_BASE_URL,
# browsers read NEXT_PUBLIC_API_BASE_URL).
CLEANHUB_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
# Development profile managed by `pnpm pos:config:local` and
# `pnpm pos:config:lan`. LAN mode also writes the detected host to
# POS_DEV_LAN_HOST and synchronizes the POS Web / Capacitor env files.
POS_DEV_PROFILE="local"
# Comma-separated list of allowed browser origins for the API.
# Must include every browser frontend dev port: web-admin (:3000), pos-web (:3001),
# mobile-web (:3002), and Capacitor's native WebView origin.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,https://localhost"
# Native Capacitor WebViews access the public API from this origin with bearer-token
# authentication and X-CleanHub-Auth-Client: mobile. It remains separate from web
# app same-origin requests when CORS_ENFORCE_SAME_ORIGIN is true.
MOBILE_NATIVE_ORIGINS="https://localhost"
# Production defaults to true: credentialed browser requests must come through
# the current frontend origin's same-origin /api reverse proxy.
CORS_ENFORCE_SAME_ORIGIN="false"

# Unpaid retail orders hold stock for this many minutes (5-1440).
POS_PRODUCT_RESERVATION_TTL_MINUTES="30"

# Object storage for media proof photos/signatures. Local development uses the
# MinIO service from docker-compose.yml; production should use dedicated strong
# credentials and a private bucket.
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="cleanhub-media"
OBJECT_STORAGE_ACCESS_KEY="cleanhub"
OBJECT_STORAGE_SECRET_KEY="cleanhub-minio-password"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS="900"
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS="300"
OBJECT_STORAGE_PENDING_TTL_SECONDS="3600"
OBJECT_STORAGE_MAX_FILE_SIZE_BYTES="5242880"
OBJECT_STORAGE_ALLOWED_CONTENT_TYPES="image/jpeg,image/png,image/webp"

# Email notifications. Local development can point this at Mailpit or MailHog
# on port 1025; production should use authenticated SMTP and a verified sender.
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT="1025"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
# Optional provider-neutral SMS receipt endpoint. It receives JSON with
# idempotencyKey, to, and message and should return an id or messageId.
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
EMAIL_FROM="CleanHub <no-reply@cleanhub.local>"
EMAIL_DEFAULT_LOCALE="en"
EMAIL_DELIVERY_DISABLED="false"
EMAIL_DELIVERY_INTERVAL_SECONDS="60"
EMAIL_DELIVERY_BATCH_SIZE="50"
EMAIL_DELIVERY_RETRY_BASE_SECONDS="60"
EMAIL_DELIVERY_RETRY_MAX_SECONDS="3600"
EMAIL_OVERDUE_TICKET_DISABLED="false"
EMAIL_OVERDUE_TICKET_BATCH_SIZE="100"

# Mobile push notifications (FCM HTTP v1). Values come from a Firebase
# service-account JSON key (Project settings -> Service accounts -> Generate
# new private key): project_id, client_email and private_key. Keep the
# private key on one line with literal \n escapes. Leaving these empty
# disables push sending (deliveries fail and retry until configured).
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
PUSH_DELIVERY_DISABLED="false"
PUSH_DELIVERY_BATCH_SIZE="50"
PUSH_DELIVERY_RETRY_BASE_SECONDS="60"
PUSH_DELIVERY_RETRY_MAX_SECONDS="3600"
