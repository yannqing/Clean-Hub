{
  "name": "@cleanhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cron:media-cleanup": "tsx src/cron/media-cleanup.ts",
    "cron:email-delivery": "tsx src/cron/email-delivery.ts",
    "backfill:delivery-proof-media": "tsx src/scripts/backfill-delivery-proof-media.ts",
    "e2e:mobile": "tsx src/e2e/mobile.e2e.ts",
    "smoke:pos-terminal-security": "tsx src/modules/auth/pos-terminal-security.smoke.ts",
    "smoke:pos-hardware": "tsx src/modules/pos/hardware/hardware.smoke.ts",
    "smoke:pos-payment-adjustments": "tsx src/modules/pos/payment-adjustments/payment-adjustments.smoke.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cleanhub/db": "workspace:*",
    "@cleanhub/domain": "workspace:*",
    "@cleanhub/hardware": "workspace:*",
    "@cleanhub/id": "workspace:*",
    "@cleanhub/logger": "workspace:*",
    "@cleanhub/storage": "workspace:*",
    "@hono/node-server": "^2.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.1",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
