# Copy variable names into your local shell or CI secret store.
# Do not copy keystores or real passwords into the repository.
CLEANHUB_ANDROID_KEYSTORE_PATH=/secure/path/cleanhub-release.keystore
CLEANHUB_ANDROID_KEYSTORE_PASSWORD=change-me
CLEANHUB_ANDROID_KEY_ALIAS=cleanhub-release
CLEANHUB_ANDROID_KEY_PASSWORD=change-me

# These are normally supplied by the release command or CI.
CLEANHUB_ANDROID_VERSION_CODE=1
CLEANHUB_ANDROID_VERSION_NAME=0.1.0
