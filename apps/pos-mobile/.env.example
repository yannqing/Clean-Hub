# Copy this file to apps/pos-mobile/.env.
#
# iPad/phone development must use the computer's LAN address. "localhost"
# points back to the device itself and therefore must not be used here.
CLEANHUB_POS_RUNTIME=development
CLEANHUB_POS_SERVER_URL=http://192.168.1.100:3001
CLEANHUB_POS_ALLOW_CLEARTEXT=true

# Production example:
# CLEANHUB_POS_RUNTIME=production
# CLEANHUB_POS_SERVER_URL=https://pos.example.com
# CLEANHUB_POS_ALLOW_CLEARTEXT=false
