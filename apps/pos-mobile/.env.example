# Prefer `pnpm pos:config:lan`, which creates apps/pos-mobile/.env together
# with the matching POS Web and API CORS settings. Copy this file only when
# configuring the native shell manually.
#
# iPad/phone development must use the computer's LAN address. "localhost"
# points back to the device itself and therefore must not be used here.
CLEANHUB_POS_RUNTIME=development
# Android 原生 POS 调用的 API Origin；手机测试时使用电脑局域网 IP 和 API 端口。
CLEANHUB_POS_API_BASE_URL=http://192.168.1.100:4000
# iOS 目前仍使用 POS Web 壳，需要 POS Web Origin。
CLEANHUB_POS_SERVER_URL=http://192.168.1.100:3001
CLEANHUB_POS_ALLOW_CLEARTEXT=true

# Optional Android package version. These may also be exported in the shell.
CLEANHUB_POS_VERSION=0.1.0
CLEANHUB_POS_BUILD_NUMBER=1

# Production example:
# CLEANHUB_POS_RUNTIME=production
# CLEANHUB_POS_API_BASE_URL=https://api.example.com
# CLEANHUB_POS_SERVER_URL=https://pos.example.com
# CLEANHUB_POS_ALLOW_CLEARTEXT=false
