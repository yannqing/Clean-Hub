# Copy this file to apps/pos-mobile/.env.production before preparing a native
# production release. The release scripts require all three values explicitly.
CLEANHUB_POS_RUNTIME=production
CLEANHUB_POS_SERVER_URL=https://pos.example.com
CLEANHUB_POS_ALLOW_CLEARTEXT=false
CLEANHUB_POS_VERSION=0.1.0
CLEANHUB_POS_BUILD_NUMBER=1

# Signing values must be exported in the release shell. The POS environment
# loader intentionally ignores signing secrets, so they are never persisted here.
