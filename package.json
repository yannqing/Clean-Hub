{
  "name": "clean-hub",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @cleanhub/api dev",
    "dev:web-admin": "pnpm --filter @cleanhub/web-admin dev",
    "dev:pos-web": "pnpm --filter @cleanhub/pos-web dev",
    "pos:config": "node scripts/configure-pos-dev.mjs status",
    "pos:config:local": "node scripts/configure-pos-dev.mjs local",
    "pos:config:lan": "node scripts/configure-pos-dev.mjs lan",
    "test:pos-config": "node scripts/configure-pos-dev.smoke.mjs",
    "dev:mobile": "pnpm --filter @cleanhub/mobile dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:integration:tenant-orders": "pnpm --filter @cleanhub/api test:integration:tenant-orders",
    "test:integration:pos-realtime": "pnpm --filter @cleanhub/api test:integration:pos-realtime",
    "test:integration:pos-realtime-proxy": "pnpm --filter @cleanhub/api test:integration:pos-realtime-proxy",
    "test:integration:tenant-rls": "pnpm --filter @cleanhub/db test:rls",
    "db:up": "docker compose up -d postgres minio minio-init",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres minio",
    "db:ps": "docker compose ps",
    "db:generate": "pnpm --filter @cleanhub/db db:generate",
    "db:migrate": "pnpm --filter @cleanhub/db db:migrate",
    "db:push": "pnpm --filter @cleanhub/db db:push",
    "db:seed": "pnpm --filter @cleanhub/db db:seed",
    "db:studio": "pnpm --filter @cleanhub/db db:studio",
    "openapi:generate": "node scripts/generate-openapi-from-routes.mjs",
    "release:build": "node scripts/build-release.mjs",
    "check:native-pos-parity": "node scripts/check-native-pos-parity.mjs",
    "package:pos-android": "pnpm --filter @cleanhub/pos-mobile package:android",
    "package:pos-android:debug": "pnpm --filter @cleanhub/pos-mobile package:android:debug",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "esbuild": "^0.27.7",
    "globals": "^17.6.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10",
    "typescript": "^5",
    "typescript-eslint": "^8.59.3"
  }
}
