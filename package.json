{
  "name": "clean-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:ps": "docker compose ps",
    "db:generate": "pnpm --filter @cleanhub/db db:generate",
    "db:migrate": "pnpm --filter @cleanhub/db db:migrate",
    "db:push": "pnpm --filter @cleanhub/db db:push",
    "db:studio": "pnpm --filter @cleanhub/db db:studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "globals": "^17.6.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10",
    "typescript": "^5",
    "typescript-eslint": "^8.59.3"
  }
}
