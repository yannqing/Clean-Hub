# Copy this file to /opt/cleanhub/.env.production on the server.
# Never commit the real production .env file.

COMPOSE_PROJECT_NAME=cleanhub

# Host-only ports consumed by the existing host Nginx reverse proxy.
WEB_ADMIN_HOST_PORT=3010
POS_WEB_HOST_PORT=3011
API_HOST_PORT=4010
WEB_ADMIN_PUBLIC_HOST=cleanhub.example.com
POS_PUBLIC_HOST=pos.cleanhub.example.com
API_PUBLIC_HOST=api.cleanhub.example.com

# PostgreSQL container.
POSTGRES_DB=cleanhub
POSTGRES_USER=cleanhub_admin
POSTGRES_PASSWORD=change-me-to-a-strong-admin-database-password
POSTGRES_APP_USER=cleanhub_app
POSTGRES_APP_PASSWORD=change-me-to-a-different-strong-app-password
# The API must use the restricted app role. Migrations and seeds use the admin
# URL because schema ownership and policy changes must not be granted to the API.
DATABASE_URL=postgres://cleanhub_app:change-me-to-a-different-strong-app-password@postgres:5432/cleanhub
DATABASE_ADMIN_URL=postgres://cleanhub_admin:change-me-to-a-strong-admin-database-password@postgres:5432/cleanhub

# Private S3-compatible object storage. MinIO is not published to the host.
MINIO_ROOT_USER=cleanhub
MINIO_ROOT_PASSWORD=change-me-to-a-strong-minio-password
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cleanhub-media
OBJECT_STORAGE_ACCESS_KEY=cleanhub
OBJECT_STORAGE_SECRET_KEY=change-me-to-a-strong-minio-password
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Phase-1 disaster recovery. This destination must be on a different provider
# or physical host from the CleanHub VPS; pointing it at the bundled MinIO does
# not protect against server/disk loss. Database snapshots run every 15 minutes
# and uploaded media is mirrored every 5 minutes by default.
BACKUP_INTERVAL_SECONDS=900
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.example-provider.com
BACKUP_S3_ACCESS_KEY=change-me-to-a-dedicated-backup-access-key
BACKUP_S3_SECRET_KEY=change-me-to-a-dedicated-backup-secret-key
BACKUP_S3_BUCKET=cleanhub-backups
BACKUP_S3_PREFIX=postgres
BACKUP_MEDIA_S3_PREFIX=object-storage
BACKUP_S3_ALLOW_INSECURE=false
BACKUP_CLOUD_SYNC_INTERVAL_SECONDS=60
BACKUP_MEDIA_SYNC_INTERVAL_SECONDS=300

# Database pool tuning.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_QUERY_TIMEOUT_MS=30000
DATABASE_POOL_KEEP_ALIVE_INITIAL_DELAY_MS=10000
DATABASE_APPLICATION_NAME=cleanhub
DATABASE_REQUIRE_RLS=true

# API runtime.
NODE_ENV=production
PORT=4000
AUTH_TOKEN_SECRET=change-me-to-a-random-secret-with-at-least-32-characters
# REQUIRED: the payment webhook route is unauthenticated by design, so this
# HMAC secret alone prevents a forged callback from marking an order paid.
# The API refuses to start in production without it. openssl rand -base64 32
PAYMENT_MOCK_SECRET=change-me-to-a-random-payment-webhook-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=true
WEB_ADMIN_PUBLIC_ORIGIN=https://cleanhub.example.com
POS_PUBLIC_ORIGIN=https://pos.cleanhub.example.com
CORS_ORIGINS=https://cleanhub.example.com,https://pos.cleanhub.example.com
CORS_ENFORCE_SAME_ORIGIN=true
LOG_LEVEL=info
SERVICE_NAME=cleanhub
# Notification delivery. Both default to disabled because they need external
# credentials; the `cron` service enqueues nothing and sends nothing until they
# are turned on, so customers get no "ready for pickup" message.
#
# EMAIL_DELIVERY_DISABLED=true stops the WHOLE delivery loop, push included:
# push deliveries are processed inside the same cron pass.
EMAIL_DELIVERY_DISABLED=false
EMAIL_DELIVERY_INTERVAL_SECONDS=60
EMAIL_SMTP_HOST=smtp.example-provider.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=change-me-to-the-smtp-username
EMAIL_SMTP_PASS=change-me-to-the-smtp-password
EMAIL_FROM=CleanHub <no-reply@cleanhub.example.com>

# Push needs a Firebase service account. Leave PUSH_DELIVERY_DISABLED=true until
# FCM_* are filled in; the customer app still works, it just gets no push.
PUSH_DELIVERY_DISABLED=true
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste with literal \n for newlines, or mount the key as a file instead.
FCM_PRIVATE_KEY=

# Housekeeping jobs, also on the `cron` service.
MEDIA_CLEANUP_DISABLED=false
MEDIA_CLEANUP_INTERVAL_SECONDS=900
TENANT_PURGE_DISABLED=false
TENANT_PURGE_INTERVAL_SECONDS=3600

# Private server-to-server API base used by the Next.js containers.
CLEANHUB_API_BASE_URL=http://api:4000

# POS Web resolves its tenant from the enrolled terminal credential. It does
# not use a build-time tenant/store code. Use this same public origin in the
# separate apps/pos-mobile/.env.production file when preparing iOS/Android.
CLEANHUB_POS_SERVER_URL=https://pos.cleanhub.example.com
